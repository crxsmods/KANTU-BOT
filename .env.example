# Copia a .env, completa secretos reales y nunca publiques ese archivo.

NODE_ENV=production
BOT_OWNERS=521XXXXXXXXXX

# POR DEFECTO NO HACE FALTA NINGUNA BASE DE DATOS.
# Cambia la ruta con LOCAL_DB_PATH si lo necesitas.
# LOCAL_DB_PATH=database

# Modo PostgreSQL propio (opcional): tiene prioridad sobre la base local.
# DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres
DB_SSL=true
# Ponlo en false solo si te conectas con un usuario sin permisos para crear
# tablas. El esquema debe existir ya.
# DB_RUN_MIGRATIONS=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_ATTEMPTS=5
DB_CONNECT_RETRY_MS=1000

# Vinculacion inicial: el metodo se elige escribiendo 1 o 2 en la consola.
# Estas variables son opcionales y solo fijan el valor por defecto que se usa
# si nadie responde (despliegue desatendido). 1=QR, 2=codigo de 8 digitos.
# PAIR_METHOD=1
# PAIR_NUMBER=5215616897881
# Segundos que espera cada pregunta antes de usar el valor por defecto.
# PAIR_PROMPT_TIMEOUT_MS=180000

# Salud y operacion
HEALTH_ENABLED=true
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3000
HEALTH_PORT_EXTERNAL=3000
HEALTH_BIND_ADDRESS=127.0.0.1
REQUIRE_FFMPEG=true
REQUIRE_WHATSAPP_SESSION=false
FFMPEG_PATH=ffmpeg
AUTO_RESTART_HOURS=0
PLUGIN_WATCH=false

# Directorios persistentes (compose.yaml fija rutas dentro del contenedor)
BOT_SESSION_DIR=./BotSession
SUBBOT_SESSION_DIR=./jadibot
TMP_DIR=./tmp
BACKUP_DIR=./backups
DATA_DIR=./data
BACKUP_SCHEMAS=public
# api_tokens y tokens siempre se excluyen; agrega aqui otras tablas no exportables.
BACKUP_EXCLUDE_TABLES=

# Solo las integraciones enumeradas aqui bloquean readiness si faltan.
REQUIRED_INTEGRATIONS=

# IA
GROQ_API_KEY=

# Reconocimiento musical
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Almacenamiento de audios
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main

# Destino de los reportes (.reporte). Acepta un grupo (...@g.us) o un numero
# privado (...@s.whatsapp.net). Vacio los envia al numero del creador.
REPORT_GROUP_JID=

# Importacion de stickers Telegram
TELEGRAM_BOT_TOKEN=
MAX_TELEGRAM_STICKERS=20
TENOR_API_KEY=

# APIs opcionales. neoxr trae una key compartida por defecto (GataDios); pon la
# tuya aqui solo si tienes una propia para no depender de la compartida.
FGMODS_API_URL=https://api.fgmods.xyz/api
FGMODS_API_KEY=
NEOXR_API_URL=https://api.neoxr.eu/api
NEOXR_API_KEY=
ALYACHAN_API_URL=https://api.alyachan.dev/api
ALYACHAN_API_KEY=
ZENKEY_API_URL=https://api.zenkey.my.id/api
ZENKEY_API_KEY=
DELIRIUS_API_URL=https://api.delirius.store
DELIRIUS_API_KEY=
SAVETUBE_AES_KEY=

# Presentacion
BOT_CARDS=off
MENU_NEWSLETTER_JID=120363371008200788@newsletter
MENU_THUMB_URL=
BOT_REPOSITORY_URL=https://github.com/crxsmods/KANTU-BOT
BOT_OFFICIAL_GROUP_URL=
BOT_OFFICIAL_CHANNEL_URL=
BOT_CONTACT_URL=
BOT_YOUTUBE_URL=
BOT_TIKTOK_URL=
BOT_INSTAGRAM_URL=
BOT_IMAGE_URL=
DONATION_URL=
