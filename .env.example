# ═══════════════════════════════════════════════════════════════════════
# Kantu Bot — Variables de entorno (EJEMPLO)
# Copia este archivo a ".env" y completa con tus valores reales.
# NUNCA subas tu ".env" real al repositorio (ya está en .gitignore).
# ═══════════════════════════════════════════════════════════════════════

# Cadena de conexión de PostgreSQL / Supabase.
#
# ⚠️ MUY IMPORTANTE: si tu contraseña tiene alguno de estos caracteres,
# DEBES codificarlos (percent-encoding) o la URL quedará inválida y el
# bot fallará al iniciar con "Invalid URL":
#   @ → %40    # → %23    : → %3A    / → %2F    % → %25    espacio → %20
#
# Ejemplo con contraseña "Mi#Clave@123":
#   DATABASE_URL=postgresql://postgres:Mi%23Clave%40123@db.xxxxx.supabase.co:5432/postgres
#
# Puedes usar: node scripts/diagnose-database-url.js  para validar tu URL
# (nunca imprime la URL/contraseña real, solo indica qué está mal).
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_basedatos

# Fuerza SSL en la conexión: "true" | "false" (por defecto se autodetecta:
# localhost = sin SSL, cualquier otro host = con SSL laxo para compatibilidad
# con proveedores como Supabase).
# DB_SSL=true

# Límite máximo de conexiones simultáneas del Pool de PostgreSQL.
DB_POOL_MAX=10

# Tiempo máximo (ms) para establecer una nueva conexión antes de fallar.
DB_CONNECTION_TIMEOUT_MS=10000

# Tiempo máximo (ms) que una conexión puede permanecer inactiva en el pool
# antes de ser cerrada.
DB_IDLE_TIMEOUT_MS=30000

# API Key de Groq (usada por _autoresponder.js y herramientas-chagpt.js).
# Se lee primero desde aquí; si no existe, se intenta un respaldo opcional
# desde la tabla api_tokens (columna token_b64, name='groq').
GROQ_API_KEY=
